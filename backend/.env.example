PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173,https://your-portfolio.vercel.app

# SMTP for contact form emails (e.g. Gmail, Resend, SendGrid SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=

# Secret required in X-Admin-Secret header to manage projects
ADMIN_SECRET=
